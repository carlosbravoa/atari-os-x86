diff --git a/configure.ac b/configure.ac
index 61d89b4a..24175205 100644
--- a/configure.ac
+++ b/configure.ac
@@ -668,10 +668,10 @@ fi
 dnl Select/detect video interface.
 
 AC_ARG_WITH([video],
-    [AS_HELP_STRING([--with-video@<:@=no|yes|curses|ncurses|pdcurses|dosvga|sdl|sdl2|javanvm@:>@],[Select video interface to use @<:@default=check@:>@])],
+    [AS_HELP_STRING([--with-video@<:@=no|yes|curses|ncurses|pdcurses|dosvga|sdl|sdl2|javanvm|kms@:>@],[Select video interface to use @<:@default=check@:>@])],
     [
         case "$withval" in
-            no | yes | check | curses | ncurses | pdcurses | dosvga | sdl | sdl2 | javanvm)
+            no | yes | check | curses | ncurses | pdcurses | dosvga | sdl | sdl2 | javanvm | kms)
                 ;;
             *)
                 AC_MSG_ERROR([unrecognized value for --with-video: "$withval"])
@@ -712,6 +712,11 @@ if [[ "$a8_target" = default ]]; then
                 AC_MSG_FAILURE([--with-video=sdl was given, but SDL library not found!])
             fi
         fi
+        if [[ "$with_video" = kms ]]; then
+            PKG_CHECK_MODULES([DRM],[libdrm],
+                [CFLAGS="$CFLAGS $DRM_CFLAGS"; LIBS="$DRM_LIBS $LIBS"],
+                [AC_MSG_ERROR([--with-video=kms was given, but libdrm not found!])])
+        fi
         if [[ "$with_video" = check -o "$with_video" = yes -o "$with_video" = curses ]]; then
             AC_CHECK_LIB([curses], [initscr],
                 [LIBS="-lcurses $LIBS"
@@ -784,6 +789,13 @@ if [[ "$a8_target" = default ]]; then
             AC_DEFINE(AF80,1,[The Austin Franklin 80 column card.])
             AC_DEFINE(BIT3,1,[The Bit3 Full View 80 column card.])
             ;;
+        kms)
+            AC_DEFINE(KMS,1,[Target: Linux DRM/KMS + evdev, no display server.])
+            AC_DEFINE(SUPPORTS_PLATFORM_CONFIGINIT,1,[Platform-specific default values.])
+            AC_DEFINE(SUPPORTS_PLATFORM_CONFIGURE,1,[Additional config file options.])
+            AC_DEFINE(SUPPORTS_PLATFORM_CONFIGSAVE,1,[Save additional config file options.])
+            AC_DEFINE(SUPPORTS_PLATFORM_PALETTEUPDATE,1,[Update the Palette if it changed.])
+            ;;
         dosvga)
             AC_DEFINE(DOSVGA,1,[Target: DOS VGA.])
             AC_DEFINE(SUPPORTS_PLATFORM_CONFIGURE,1,[Additional config file options.])
@@ -806,6 +818,7 @@ AM_CONDITIONAL(WITH_VIDEO_JAVANVM, test "$with_video" = javanvm)
 AM_CONDITIONAL(WITH_VIDEO_SDL, test "$with_video" = sdl)
 AM_CONDITIONAL(WITH_VIDEO_SDL2, test "$with_video" = sdl2)
 AM_CONDITIONAL(WITH_VIDEO_DOSVGA, test "$with_video" = dosvga)
+AM_CONDITIONAL(WITH_VIDEO_KMS, test "$with_video" = kms)
 AM_CONDITIONAL(WITH_VIDEO_CURSES, test "$with_video" = curses -o "$with_video" = ncurses -o "$with_video" = pdcurses)
 AM_CONDITIONAL(WITH_VIDEO_LIBATARI800, test "$a8_target" = libatari800)
 AM_CONDITIONAL(WITH_VIDEO_NO, test "$with_video" = no)
@@ -1002,10 +1015,10 @@ fi
 dnl Select/detect sound interface.
 
 AC_ARG_WITH([sound],
-    [AS_HELP_STRING([--with-sound@<:@=no|yes|dossb|oss|falcon|sdl|sdl2|javanvm@:>@],[Select sound interface to use @<:@default=check@:>@])],
+    [AS_HELP_STRING([--with-sound@<:@=no|yes|dossb|oss|falcon|sdl|sdl2|javanvm|alsa@:>@],[Select sound interface to use @<:@default=check@:>@])],
     [
         case "$withval" in
-            no | yes | check | dossb | oss | falcon | sdl | sdl2 | javanvm)
+            no | yes | check | dossb | oss | falcon | sdl | sdl2 | javanvm | alsa)
                 ;;
             *)
                 AC_MSG_ERROR([unrecognized value for --with-sound: "$withval"])
@@ -1061,6 +1074,10 @@ elif [[ "$a8_target" != "ps2" -a "$a8_target" != "android" ]]; then
                 AC_MSG_FAILURE([--with-sound=sdl was given, but SDL library not found!])
             fi
         fi
+        if [[ "$with_sound" = alsa ]]; then
+            AC_CHECK_LIB(asound, snd_pcm_open,,
+                [AC_MSG_ERROR([--with-sound=alsa was given, but alsa-lib not found!])])
+        fi
         if [[ "$with_sound" = check -o "$with_sound" = yes -o "$with_sound" = oss ]]; then
             if [[ "$SUPPORTS_SOUND_OSS" = yes ]]; then
                 with_sound=oss
@@ -1085,6 +1102,8 @@ elif [[ "$a8_target" != "ps2" -a "$a8_target" != "android" ]]; then
         dossb)
             WANT_SOUND_CALLBACK=yes
             ;;
+        alsa)
+            ;;
         no)
             ;;
         *)
@@ -1096,6 +1115,7 @@ AM_CONDITIONAL([WITH_SOUND], test "$with_sound" != no)
 AM_CONDITIONAL([WITH_SOUND_JAVANVM], test "$with_sound" = javanvm)
 AM_CONDITIONAL([WITH_SOUND_FALCON], test "$with_sound" = falcon)
 AM_CONDITIONAL([WITH_SOUND_OSS], test "$with_sound" = oss)
+AM_CONDITIONAL([WITH_SOUND_ALSA], test "$with_sound" = alsa)
 AM_CONDITIONAL([WITH_SOUND_SDL], test "$with_sound" = sdl)
 AM_CONDITIONAL([WITH_SOUND_SDL2], test "$with_sound" = sdl2)
 AM_CONDITIONAL([WITH_SOUND_DOSSB], test "$with_sound" = dossb)
diff --git a/src/Makefile.am b/src/Makefile.am
