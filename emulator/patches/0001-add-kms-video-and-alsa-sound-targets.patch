+	   (kms/video.c PLATFORM_Sleep), a panel slightly faster than the
+	   Atari would let this clock run ahead without bound, and the first
+	   timer-paced frame afterwards (a menu, turbo) would stall. */
+	else if (lasttime > curtime + deltatime)
+		lasttime = curtime;
+#endif
