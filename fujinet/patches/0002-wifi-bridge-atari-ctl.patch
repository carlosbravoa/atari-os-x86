 // Global object to manage WiFi
 DummyWiFiManager fnWiFi;
 
+/*
+ * atari-os-x86 bridge: when the appliance's PID 1 control socket exists,
+ * the "WiFi" FujiNet sees is the laptop's network. connected() means "the
+ * laptop has an IP address" (Wi-Fi or Ethernet), scans and connects are
+ * forwarded to init, which drives wpa_supplicant (the same requests the F8
+ * System menu makes). Without the socket nothing changes.
+ */
+#define ATARI_CTL_SOCK "/run/atari.ctl"
+#define BRIDGE_STATUS_CACHE_S 2.0
+// The Atari waits about 16 s (DTIMLO 0x0F) for a FujiNet command to
+// complete; stay well below that. CONFIG polls the status afterwards.
+#define BRIDGE_CONNECT_WAIT_S 12
+
+static bool bridge_mode = false;
+
+struct BridgeStatus
+{
+    bool valid = false;
+    double when = 0;
+    std::string ip;      // "ip <addr>"
+    std::string wifi;    // text after "wifi "
+    std::string wifierr; // text after "wifierr "
+};
+static BridgeStatus bridge_st;
+
+struct BridgeNet
+{
+    std::string ssid;
+    int signal;
+    uint8_t encryption;
+};
+static std::vector<BridgeNet> bridge_nets;
+
+static double bridge_now()
+{
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+// One request to init: write "<cmd>\n", read the reply until init closes.
+// Returns false when the socket cannot be used.
+static bool bridge_request(const std::string &cmd, std::string &out)
+{
+    out.clear();
+#ifdef _WIN32
+    (void)cmd;
+    return false;
+#else
+    int fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+    if (fd < 0)
+        return false;
+    struct timeval tv;
+    tv.tv_sec = 3;
+    tv.tv_usec = 0;
+    setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+    setsockopt(fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+    struct sockaddr_un addr;
+    memset(&addr, 0, sizeof(addr));
+    addr.sun_family = AF_UNIX;
+    strlcpy(addr.sun_path, ATARI_CTL_SOCK, sizeof(addr.sun_path));
+    if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0)
+    {
+        close(fd);
+        return false;
+    }
+    std::string line = cmd + "\n";
+    if (write(fd, line.data(), line.size()) != (ssize_t)line.size())
+    {
+        close(fd);
+        return false;
+    }
+    char buf[1024];
+    for (;;)
+    {
+        ssize_t n = read(fd, buf, sizeof(buf));
+        if (n <= 0)
+            break;
+        out.append(buf, (size_t)n);
+        if (out.size() > 65536)
+            break;
+    }
+    close(fd);
+    return true;
+#endif
+}
+
+static bool starts_with(const std::string &s, const char *prefix)
+{
+    return s.compare(0, strlen(prefix), prefix) == 0;
+}
+
+// Calls fn(line) for every line of a reply (without the newline).
+template <typename F>
+static void for_each_line(const std::string &reply, F fn)
+{
+    size_t pos = 0;
+    while (pos < reply.size())
+    {
+        size_t nl = reply.find('\n', pos);
+        std::string line = reply.substr(pos, nl == std::string::npos ? std::string::npos : nl - pos);
+        if (!line.empty() && line.back() == '\r')
+            line.pop_back();
+        fn(line);
+        if (nl == std::string::npos)
+            break;
+        pos = nl + 1;
+    }
+}
+
+static const BridgeStatus &bridge_status(bool force)
+{
+    double now = bridge_now();
+    if (!force && bridge_st.valid && now - bridge_st.when < BRIDGE_STATUS_CACHE_S)
+        return bridge_st;
+    std::string reply;
+    BridgeStatus st;
+    st.valid = true;
+    st.when = now;
+    if (bridge_request("status", reply))
+    {
+        for_each_line(reply, [&st](const std::string &line) {
+            if (starts_with(line, "ip "))
+                st.ip = line.substr(3);
+            else if (starts_with(line, "wifierr "))
+                st.wifierr = line.substr(8);
+            else if (starts_with(line, "wifi "))
+                st.wifi = line.substr(5);
+        });
+    }
+    bridge_st = st;
+    return bridge_st;
+}
+
+static void bridge_invalidate()
+{
+    bridge_st.valid = false;
+}
+
+// Name of the interface that holds addr, or "".
+static std::string bridge_iface_of(const std::string &ip)
+{
+    std::string name;
+#ifndef _WIN32
+    struct ifaddrs *ifa = nullptr;
+    if (ip.empty() || getifaddrs(&ifa) != 0)
+        return name;
+    for (struct ifaddrs *i = ifa; i != nullptr; i = i->ifa_next)
+    {
+        char a[INET_ADDRSTRLEN];
+        if (i->ifa_addr == nullptr || i->ifa_addr->sa_family != AF_INET)
+            continue;
+        if (inet_ntop(AF_INET, &((struct sockaddr_in *)i->ifa_addr)->sin_addr, a, sizeof(a)) && ip == a)
+        {
+            name = i->ifa_name;
+            break;
+        }
+    }
+    freeifaddrs(ifa);
+#endif
+    return name;
+}
+
+static bool bridge_mac(uint8_t mac[6])
+{
+    std::string iface = bridge_iface_of(bridge_status(false).ip);
+    if (iface.empty() || iface.find('/') != std::string::npos)
+        return false;
+    std::string path = "/sys/class/net/" + iface + "/address";
+    FILE *f = fopen(path.c_str(), "r");
+    if (f == nullptr)
+        return false;
+    unsigned int m[6];
+    int n = fscanf(f, "%x:%x:%x:%x:%x:%x", &m[0], &m[1], &m[2], &m[3], &m[4], &m[5]);
+    fclose(f);
+    if (n != 6)
+        return false;
+    for (int i = 0; i < 6; i++)
+        mac[i] = (uint8_t)m[i];
+    return true;
+}
+
+// Forward a connect to init and wait (bounded) for the result.
+static int bridge_connect(const char *ssid, const char *password)
+{
+    std::string reply;
+    std::string s = ssid == nullptr ? "" : ssid;
+    std::string cmd = "wifi connect\t" + s + "\t" + (password == nullptr ? "" : password);
+
+    Debug_printf("DummyWiFi (atari-os bridge) connect to SSID \"%s\"\r\n", s.c_str());
+    if (!bridge_request(cmd, reply) || starts_with(reply, "ERR"))
+    {
+        Debug_printf("DummyWiFi (atari-os bridge) connect refused: %s\r\n",
+                     reply.empty() ? "no reply" : reply.c_str());
+        return -1;
+    }
+    for (int i = 0; i < BRIDGE_CONNECT_WAIT_S; i++)
+    {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        const BridgeStatus &st = bridge_status(true);
+        if (!st.wifierr.empty())
+        {
+            Debug_printf("DummyWiFi (atari-os bridge) connect failed: %s\r\n", st.wifierr.c_str());
+            return -1;
+        }
+        if (st.wifi == "connected " + s && !st.ip.empty())
+        {
+            Debug_printf("DummyWiFi (atari-os bridge) connected, ip %s\r\n", st.ip.c_str());
+            return 0;
+        }
+    }
+    Debug_printf("DummyWiFi (atari-os bridge) not connected after %d s (%s)\r\n",
+                 BRIDGE_CONNECT_WAIT_S, bridge_st.wifi.c_str());
+    return -1;
+}
